# Copy to .env.local for `next dev`. Never commit real values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Google OAuth web client (same one Supabase's Google provider uses):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, Google Picker (agenda Doc + meeting folder). Both empty: the Picker is off and the
# start screen offers only a new Doc. API key restricted to the Picker API + HTTP referrers;
# the project number of the same Cloud project (the Picker's appId).
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENC_KEY=
ELEVENLABS_API_KEY=
# manual | vad | turn_prediction; default vad (provisional until the Task 0 spike)
ELEVENLABS_COMMIT_STRATEGY=vad
# ElevenLabs cost booked per closed session (optional; default 0.22)
ELEVENLABS_USD_PER_HOUR=0.22
ANTHROPIC_API_KEY=
# Optional until Task 12 (email):
RESEND_API_KEY=
ALARM_EMAIL=simon@harrysson.co
CRON_SECRET=
APP_URL=http://localhost:3000
GLOBAL_DAILY_HOURS=30
GLOBAL_DAILY_USD=25
KILL_SWITCH=0
